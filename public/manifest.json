{
  "manifest_version": 3,
  "name": "ASCII Scenery & Animals New Tab",
  "short_name": "ASCII Scenery",
  "version": "1.0.0",
  "description": "A calm New Tab of animated ASCII scenery and animals that follows your local time and live weather.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ascii-scenery-newtab@local",
      "strict_min_version": "109.0"
    }
  }
}
